# Nothing charge HAL (vendor.noth.hardware.charge-service) runs in
# hal_health_default; battery/thermal/touch sysfs access mirrors the
# stock vendor_hal_charge_default rules.
allow hal_health_default sysfs_batteryinfo:dir r_dir_perms;
allow hal_health_default sysfs_batteryinfo:file rw_file_perms;
allow hal_health_default sysfs_therm:dir r_dir_perms;
allow hal_health_default sysfs_therm:file r_file_perms;
allow hal_health_default proc_touchpanel:dir r_dir_perms;
allow hal_health_default proc_touchpanel:file rw_file_perms;
