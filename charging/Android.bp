cc_binary {
    name: "chargingd",
    vendor: true,
    cflags: [
        "-Wall",
        "-Werror",
        "-DLOG_TAG=\"chargingd\"",
    ],
    init_rc: ["chargingd.rc"],
    srcs: [
        "ChargingController.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "liblog",
    ],
}

// Deliberately bionic-only: shell may execute this vendor binary but may
// not open files out of /vendor/lib64, so no libbase/liblog/libc++.
cc_binary {
    name: "chargingctl",
    vendor: true,
    cflags: [
        "-Wall",
        "-Werror",
    ],
    srcs: ["chargingctl.c"],
}
