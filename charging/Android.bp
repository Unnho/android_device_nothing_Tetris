cc_binary {
    name: "chargingd",
    vendor: true,
    cflags: [
        "-Wall",
        "-Werror",
        "-DLOG_TAG=\"chargingd\"",
    ],
    init_rc: ["chargingd.rc"],
    srcs: [
        "ChargingController.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "liblog",
    ],
}
